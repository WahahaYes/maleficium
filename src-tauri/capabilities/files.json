{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "files",
  "description": "Capability for file system and dialog operations",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}