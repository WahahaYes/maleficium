\newcommand{\mfw@isdark}[1]{%
  \extractcolorspecs{#1}\mfw@cm\mfw@cs
  \convertcolorspec{\mfw@cm}{\mfw@cs}{gray}\mfw@gray
  \ifdim\mfw@gray pt<0.45pt\relax\mfw@darkplatetrue\else\mfw@darkplatefalse\fi}
\newcommand{\mfw@hexof}[2]{%
  \extractcolorspecs{#1}\mfw@cm\mfw@cs
  \convertcolorspec{\mfw@cm}{\mfw@cs}{HTML}#2}
\newcommand{\mfw@line}[3]{\immediate\write\mfw@sidecar{theme|#1|#2|#3}}
% #1 mode, #2 the plate's colour name: the plate and what sits on it.
\newcommand{\mfw@plate}[2]{%
  \mfw@isdark{#2}%
  \mfw@hexof{#2}\mfw@platehex
  \mfw@line{#1}{--m-figure-bg}{\mfw@hash\mfw@platehex}%
  \ifmfw@darkplate\colorlet{mfw@fs}{#2!94!white}\else\colorlet{mfw@fs}{#2!94!black}\fi
  \mfw@hexof{mfw@fs}\mfw@fshex
  \mfw@line{#1}{--m-figure-surface}{\mfw@hash\mfw@fshex}%
  \@for\mfw@n:=\mfw@names@fig\do{%
    \mfw@line{#1}{\mfw@n}{\csname mfw@\ifmfw@darkplate fd\else fl\fi @\mfw@n\endcsname}}%
}
% -- reader styling ----------------------------------------------------------
% \maleficiumreaderstyle{reader.css}: a stylesheet in the project that the
% reflowed reader applies after its own rules, in light and dark mode alike
% (the PDF never changes). See the README's Interactive papers for what it
% may hold; the exporter checks it.
\def\mfw@r@style{}
\newcommand{\maleficiumreaderstyle}[1]{%
  \mfw@valid@css{#1}%
  \ifmfw@ok\else
    \PackageError{maleficium-interactive}%
      {\protect\maleficiumreaderstyle{#1}: not a plain .css path}%
      {Name a .css file in the project: letters, digits, . _ - and /.}%
  \fi
  \mfw@needfile{#1}%
  \gdef\mfw@r@style{#1}}
\newcommand{\mfw@write@theme}{%
  \mfw@open@sidecar
  \ifx\mfw@r@style\empty\else
    \immediate\write\mfw@sidecar{style|\mfw@r@style}\fi
  \mfw@usefont{\rmdefault}{\mfw@font@body}%
  \mfw@usefont{\sfdefault}{\mfw@font@heading}%
  \mfw@usefont{\ttdefault}{\mfw@font@mono}%
  \mfw@line{light}{--m-font-body}{\mfw@font@body, Georgia, serif}%
  \mfw@line{light}{--m-font-heading}{\mfw@font@heading, system-ui, sans-serif}%
  \mfw@line{light}{--m-font-mono}{\mfw@font@mono, ui-monospace, monospace}%
  \@for\mfw@n:=\mfw@names@shared\do{%
    \mfw@line{light}{\mfw@n}{\csname mfw@v@\mfw@n\endcsname}}%
  \@for\mfw@n:=\mfw@names@moded\do{%
    \mfw@line{light}{\mfw@n}{\csname mfw@l@\mfw@n\endcsname}}%
  \mfw@plate{light}{mfwpage}%
  \@for\mfw@n:=\mfw@names@moded\do{%
    \mfw@line{dark}{\mfw@n}{\csname mfw@d@\mfw@n\endcsname}}%
  \mfw@isdark{mfwpage}%
  \ifmfw@darkplate\mfw@plate{dark}{mfwpage}\else\mfw@plate{dark}{mfwdarkplate}\fi
}
\AtEndDocument{\mfw@write@theme}

% -- annotation and placement ------------------------------------------------
% The special must sit inline with the poster box: bare in vertical mode the
% driver drops it. Dims come from the set box, so the rect matches the poster.
\newcommand{\mfw@dospec}{%
  \edef\mfw@spec{pdf: ann @mfw@\mfw@id\space
    width \the\wd\mfw@box\space height \the\ht\mfw@box\space
    depth \the\dp\mfw@box\space
    << /Type /Annot /Subtype /Link /Border [0 0 0]
    /Contents (Maleficium interactive widget \mfw@id) /NM (mfw:\mfw@id) >>}%
  \expandafter\special\expandafter{\mfw@spec}%
}
% The poster box goes down first (visible, zero advance), the annotation
% lands on its origin, then the line advances past it. The advance is a
% kern, not glue: \par drops trailing glue, which left the line zero wide so
% \centering put the poster's left edge at the centre of the column.
\newcommand{\mfw@emit}{%
  \leavevmode\rlap{\usebox{\mfw@box}}\mfw@dospec\kern\wd\mfw@box\par
}

% -- shared checks -----------------------------------------------------------
\newcommand{\mfw@needfile}[1]{%
  \IfFileExists{#1}{}{\PackageError{maleficium-interactive}%
    {File `#1' not found}{Put it in the project or fix the path.}}%
}
% A poster= given must exist; model, chart and html widgets may leave it out
% (an html widget's auto-poster exists only once the user approved it).
\newcommand{\mfw@needposter}{\ifx\mfw@poster\empty\else\mfw@needfile{\mfw@poster}\fi}
% Canonicalize height/width through a length: \linewidth resolves, garbage
% fails here, and the sidecar records unambiguous pt.
\newcommand{\mfw@sizecanon}{%
  \setlength{\mfw@dim}{\mfw@height}%
  \edef\mfw@height@pt{\the\mfw@dim}%
  \ifx\mfw@width\empty
    \def\mfw@width@pt{}%
  \else
    \setlength{\mfw@dimw}{\mfw@width}%
    \edef\mfw@width@pt{\the\mfw@dimw}%
  \fi
}
\newcommand{\mfw@dims@opt}{%
  \ifx\mfw@width@pt\empty height=\mfw@height@pt\else
    height=\mfw@height@pt,width=\mfw@width@pt\fi
}
% Graphicx reads the option list through keyval, which splits keys before
% expanding: the keys, = and commas must be literal tokens, so they are
% written out here. Only values may be macros.
\newcommand{\mfw@sbox@graphic}[1]{%
  \ifx\mfw@width\empty
    \sbox{\mfw@box}{\includegraphics[height=\mfw@height]{#1}}%
  \else
    \sbox{\mfw@box}{\includegraphics[height=\mfw@height,width=\mfw@width,keepaspectratio]{#1}}%
  \fi
}

% -- posters ------------------------------------------------------------------
% #1 runtime, #2 sources, #3 options, exactly as \mfw@record gets them. Sets
% \mfw@box: the document's poster=, else the mapped auto-poster when the
% widget's record still matches and the file is there, else a placeholder.
\newcommand{\mfw@posterbox}[3]{%
  \ifx\mfw@poster\empty
    \def\mfw@auto{}%
    \ifcsname mfw@pm@r@\mfw@id\endcsname
      \mfw@safe{#1}{mfw@k@rt}\mfw@safe{#2}{mfw@k@src}\mfw@safe{#3}{mfw@k@opt}%
      \mfw@foldspaces@x{\mfw@k@rt|\mfw@k@src|\mfw@k@opt}%
      \expandafter\ifx\csname mfw@pm@r@\mfw@id\endcsname\mfw@folded
        \edef\mfw@auto{.maleficium/posters/\csname mfw@pm@k@\mfw@id\endcsname.png}%
        \IfFileExists{\mfw@auto}{}{\def\mfw@auto{}}%
      \fi
    \fi
    \ifx\mfw@auto\empty\mfw@placeholder\else\mfw@sbox@graphic{\mfw@auto}\fi
  \else
    \mfw@sbox@graphic{\mfw@poster}%
  \fi
}
% The placeholder: height=, by width= or else 4:3 (a model's size= aspect).
\def\mfw@aspect#1x#2\@nil{\setlength{\mfw@dimw}{\dimexpr\mfw@dim*#1/#2\relax}}
\newcommand{\mfw@placeholder}{%
  \setlength{\mfw@dim}{\mfw@height}%
  \ifx\mfw@width\empty
    \ifx\mfw@p@size\empty
      \setlength{\mfw@dimw}{\dimexpr\mfw@dim*4/3\relax}%
    \else
      \expandafter\mfw@aspect\mfw@p@size\@nil
    \fi
  \else
    \setlength{\mfw@dimw}{\mfw@width}%
  \fi
  \sbox{\mfw@box}{%
    \begin{tikzpicture}
      \useasboundingbox (0pt,0pt) rectangle (\the\mfw@dimw,\the\mfw@dim);
      \filldraw[fill=mfwaccent!6, draw=mfwmuted!70, line width=0.4pt]
        (0.2pt,0.2pt) rectangle
        (\the\dimexpr\mfw@dimw-0.2pt\relax,\the\dimexpr\mfw@dim-0.2pt\relax);
      \node[align=center, font=\sffamily\scriptsize,
          text width=\the\dimexpr\mfw@dimw-8pt\relax]
        at (\the\dimexpr\mfw@dimw/2\relax,\the\dimexpr\mfw@dim/2\relax)
        {\textcolor{mfwaccent}{\bfseries Interactive \mfw@type}\\
         \textcolor{mfwmuted}{poster pending}};
    \end{tikzpicture}}%
}

% -- poster parameters ---------------------------------------------------------
% #1 the keys this widget type takes (the rest must stay empty), #2 the type.
\newcommand{\mfw@params}[2]{%
  \@for\mfw@k:={camera,size,background,scale,framedomains,resourcedomains}\do{%
    \expandafter\ifx\csname mfw@p@\mfw@k\endcsname\empty\else
      \mfw@ifin{\mfw@k}{#1}{%
        \csname mfw@check@\mfw@k\endcsname
        \ifmfw@ok\else
          \PackageError{maleficium-interactive}%
            {\mfw@k= `\csname mfw@p@\mfw@k\endcsname' is malformed}%
            {\mfw@paramhelp}%
        \fi
      }{%
        \PackageError{maleficium-interactive}%
          {\mfw@k= does not apply to #2 widgets}%
          {Remove it. \mfw@paramhelp}%
      }%
    \fi
  }%
}
\def\mfw@paramhelp{Model widgets take camera={16 numbers} or
  camera={pos=x,y,z target=x,y,z up=x,y,z}, size=800x600 and
  background=ffffff or transparent; chart widgets take scale=2; html
  widgets take framedomains= and resourcedomains= (https origins
  separated by spaces).}
% \mfw@ifin{<key macro>}{<comma list>}{<yes>}{<no>}
\newcommand{\mfw@ifin}[4]{%
  \def\mfw@found{0}%
  \@for\mfw@x:=#2\do{\ifx\mfw@x#1\def\mfw@found{1}\fi}%
  \if1\mfw@found #3\else #4\fi
}

% -- the macros --------------------------------------------------------------
\newcommand{\interactivemodel}[2][]{%
  \mfw@resetkeys\setkeys{mfw}{#1}%
  \mfw@needalt%
  \def\mfw@type{model}\ifx\mfw@runtime\empty\def\mfw@runtime{model@1}\fi
  \mfw@params{camera,size,background}{model}%
  \mfw@needposter\mfw@needfile{#2}%
  \mfw@resolve@id\mfw@sizecanon
  \mfw@snap@fig%
  \def\mfw@opts{\mfw@dims@opt,camera=\mfw@p@camera,size=\mfw@p@size,background=\mfw@p@background}%
  \mfw@posterbox{\mfw@runtime}{model=#2}{\mfw@opts}%
  \mfw@record{\mfw@type}{\mfw@runtime}{\mfw@floatlabel}{\mfw@figno}%
    {\mfw@poster}{model=#2}{\mfw@opts}%
  \mfw@emit
}

\newcommand{\interactivevideo}[2][]{%
  \mfw@resetkeys\setkeys{mfw}{#1}%
  \mfw@needalt%
  \def\mfw@type{video}\ifx\mfw@runtime\empty\def\mfw@runtime{video@1}\fi
  \mfw@params{}{video}%
  \mfw@needfile{\mfw@poster}%
  \IfFileExists{#2}{%
    \def\mfw@vidsrc{#2}%
    \ifx\mfw@sha\empty\else\fi
  }{%
    \ifx\mfw@remote\empty
      \PackageError{maleficium-interactive}{File `#2' not found}%
        {Give remote=... with a sha256=... when no local copy exists.}%
    \else
      \PackageWarning{maleficium-interactive}%
        {File `#2' missing; recording the remote URL only}%
      \def\mfw@vidsrc{}%
    \fi
  }%
  \mfw@resolve@id\mfw@sizecanon
  \mfw@snap@fig%
  \mfw@sbox@graphic{\mfw@poster}%
  \mfw@record{\mfw@type}{\mfw@runtime}{\mfw@floatlabel}{\mfw@figno}%
    {\mfw@poster}{video=\mfw@vidsrc}%
    {\mfw@dims@opt,remote=\mfw@remote,sha256=\mfw@sha}%
  \mfw@emit
}

% The poster is the typeset rows; the exporter crops it from the PDF.
\newcommand{\interactivetable}[2][]{%
  \mfw@resetkeys\setkeys{mfw}{#1}%
  \mfw@needalt%
  \def\mfw@type{table}\ifx\mfw@runtime\empty\def\mfw@runtime{table@1}\fi
  \mfw@params{}{table}%
  \ifx\mfw@poster\empty\else
    \PackageWarning{maleficium-interactive}%
      {poster= is ignored for tables; the typeset rows are the poster}%
  \fi
  \mfw@needfile{#2}%
  \ifx\mfw@pdfrows\empty
    \PackageError{maleficium-interactive}%
      {pdfrows must be a non-negative integer, not empty}%
      {Pass pdfrows=10 or similar.}%
  \else
    \mfw@valid@digits
    \ifmfw@ok\else
      \PackageError{maleficium-interactive}%
        {pdfrows must be a non-negative integer, not `\mfw@pdfrows'}%
        {Pass pdfrows=10 or similar.}%
    \fi
  \fi
  \mfw@resolve@id
  \mfw@snap@fig%
  \sbox{\mfw@box}{\pgfplotstabletypeset[
    col sep=comma, header=true, string type,
    skip rows between index={\mfw@pdfrows}{1000000},
    every head row/.style={before row=\hline, after row=\hline},
    every last row/.style={after row=\hline}]%
    {#2}}%
  \mfw@record{\mfw@type}{\mfw@runtime}{\mfw@floatlabel}{\mfw@figno}%
    {}{data=#2}{pdfrows=\mfw@pdfrows}%
  \mfw@emit
}

\newcommand{\interactivechart}[2][]{%
  \mfw@resetkeys\setkeys{mfw}{#1}%
  \mfw@needalt%
  \def\mfw@type{chart}\ifx\mfw@runtime\empty\def\mfw@runtime{chart@1}\fi
  \mfw@params{scale}{chart}%
  \mfw@needposter\mfw@needfile{#2}%
  \def\mfw@srcs{spec=#2}%
  \ifx\mfw@data\empty\else
    \@for\mfw@f:=\mfw@data\do{%
      \mfw@needfile{\mfw@f}%
      \edef\mfw@srcs{\mfw@srcs,data=\mfw@f}%
    }%
  \fi
  \mfw@resolve@id\mfw@sizecanon
  \mfw@snap@fig%
  \def\mfw@opts{\mfw@dims@opt,scale=\mfw@p@scale}%
  \mfw@posterbox{\mfw@runtime}{\mfw@srcs}{\mfw@opts}%
  \mfw@record{\mfw@type}{\mfw@runtime}{\mfw@floatlabel}{\mfw@figno}%
    {\mfw@poster}{\mfw@srcs}{\mfw@opts}%
  \mfw@emit
}

\newcommand{\interactive}[2][]{%
  \mfw@resetkeys\setkeys{mfw}{#1}%
  \mfw@needalt%
  \def\mfw@type{html}%
  \mfw@params{framedomains,resourcedomains}{html}%
  \mfw@needposter\mfw@needfile{#2/index.html}%
  \mfw@resolve@id\mfw@sizecanon
  \mfw@snap@fig%
  \def\mfw@opts{\mfw@dims@opt}%
  \ifx\mfw@p@framedomains\empty\else
    \expandafter\def\expandafter\mfw@opts\expandafter{%
      \mfw@opts,framedomains=\mfw@p@framedomains}%
  \fi
  \ifx\mfw@p@resourcedomains\empty\else
    \expandafter\def\expandafter\mfw@opts\expandafter{%
      \mfw@opts,resourcedomains=\mfw@p@resourcedomains}%
  \fi
  \mfw@posterbox{}{bundle=#2}{\mfw@opts}%
  \mfw@record{\mfw@type}{}{\mfw@floatlabel}{\mfw@figno}%
    {\mfw@poster}{bundle=#2}{\mfw@opts}%
  \mfw@emit
}

% \interactiveruntime: a widget run by a custom runtime, named by runtime=
% <name>@<major>. The package cannot know the runtime's roles or options
% (it must compile with none installed), so the main argument is recorded
% under the reserved role primary and every key that is not the macro's own
% rides to the app as an option, verbatim. xkeyval's \setkeys* leaves such
% keys untouched in \XKV@rm, braces and = inside values included. What is
% checked here needs no runtime: shapes, reserved names, files, commas.
\newif\ifmfw@rt@eq
% Split an entry at its first top-level =, into \mfw@rt@k and \mfw@rt@v;
% \ifmfw@rt@eq tells whether there was one.
\def\mfw@rt@split#1=#2\@nil{\def\mfw@rt@k{#1}\def\mfw@rt@v{#2}}
\newcommand{\mfw@rt@kv}[1]{%
  \in@{=}{#1}%
  \ifin@
    \mfw@rt@eqtrue\mfw@rt@split#1\@nil
  \else
    \mfw@rt@eqfalse\def\mfw@rt@k{#1}\def\mfw@rt@v{}%
  \fi
  \mfw@rt@trim\mfw@rt@k\mfw@rt@trim\mfw@rt@v
}
\newcommand{\mfw@rt@checkcomma}[1]{%
  \mfw@rt@nocomma\mfw@rt@v
  \ifmfw@ok\else
    \PackageError{maleficium-interactive}%
      {character `,' is not allowed in #1}%
      {Recorded values are split on commas; remove it from the value or path.}%
  \fi
}
\newcommand{\mfw@rt@checkref}{%
  \ifx\mfw@runtime\empty
    \PackageError{maleficium-interactive}%
      {\string\interactiveruntime\space needs runtime=<name>@<major>}%
      {Pass runtime=stl-viewer@1.}%
  \else
    \mfw@rt@isref\mfw@runtime
    \ifmfw@ok
      \mfw@rt@setname\mfw@runtime
      \mfw@rt@isreservedname\mfw@rt@n
      \ifmfw@ok
        \PackageError{maleficium-interactive}%
          {runtime name `\mfw@rt@n' is reserved}%
          {The built-in kinds, m-... and maleficium... are taken; name your runtime otherwise.}%
      \fi
    \else
      \PackageError{maleficium-interactive}%
        {runtime= `\mfw@runtime' must be <name>@<major>: a lowercase letter,
          1 to 39 letters, digits or dashes, then @ and a major version 1 to 9999}%
        {Pass runtime=stl-viewer@1.}%
    \fi
  \fi
}
% poster= is optional for \interactiveruntime: with none, the pdf shows
% the runtime's proposed poster (once allowed and rendered) or a
% placeholder. A given poster must exist.
\newcommand{\mfw@rt@needposter}{%
  \ifx\mfw@poster\empty\else
    \mfw@needfile{\mfw@poster}%
  \fi
}
% One sources= entry: role=path, the role a plain word, not primary and not
% given before (a flag per widget id and role), the file there.
\newcommand{\mfw@rt@source}[1]{%
  \mfw@rt@kv{#1}%
  \ifmfw@rt@eq\ifx\mfw@rt@v\empty\mfw@rt@eqfalse\fi\fi
  \ifmfw@rt@eq
    \mfw@rt@isrole\mfw@rt@k
    \ifmfw@ok
      \ifcsname mfw@rt@r@\mfw@id @\mfw@rt@k\endcsname
        \PackageError{maleficium-interactive}%
          {source role `\mfw@rt@k' is given twice}%
          {Each role may appear once in sources=.}%
      \fi
      \expandafter\gdef\csname mfw@rt@r@\mfw@id @\mfw@rt@k\endcsname{}%
    \else
      \PackageError{maleficium-interactive}%
        {source role `\mfw@rt@k' must be a lowercase letter then up to 15
          letters or digits, and not primary}%
        {Write sources={texture=img/steel.png, labels=data/labels.csv}.}%
    \fi
    \mfw@rt@checkcomma{\mfw@rt@k}%
    \mfw@needfile{\mfw@rt@v}%
    \mfw@rt@add\mfw@srcs
  \else
    \PackageError{maleficium-interactive}%
      {sources= entry `#1' must be role=path}%
      {Write sources={texture=img/steel.png, labels=data/labels.csv}.}%
  \fi
}
% One leftover key: an author option. It needs a value (an empty one means
% the runtime's default), is a plain word and none of the package's own keys.
\newcommand{\mfw@rt@option}[1]{%
  \mfw@rt@kv{#1}%
  \ifmfw@rt@eq
    \mfw@rt@isreservedkey\mfw@rt@k
    \ifmfw@ok
      \PackageError{maleficium-interactive}%
        {option key `\mfw@rt@k' is reserved by the package}%
        {\string\interactiveruntime\space gives these keys a meaning of their own; pick another option name.}%
    \else
      \mfw@rt@iskey\mfw@rt@k
      \ifmfw@ok\else
        \PackageError{maleficium-interactive}%
          {option key `\mfw@rt@k' must be a lowercase letter then up to 23
            letters or digits}%
          {Option keys are the runtime's own names, such as color or autorotate.}%
      \fi
    \fi
    \mfw@rt@checkcomma{\mfw@rt@k}%
    \mfw@rt@add\mfw@opts
  \else
    \PackageError{maleficium-interactive}%
      {option `\mfw@rt@k' needs a value: write \mfw@rt@k=...}%
      {An option is written key=value; key= alone uses the runtime's default.}%
  \fi
}
\newcommand{\interactiveruntime}[2][]{%
  \mfw@resetkeys\def\mfw@rt@sources{}\def\XKV@rm{}%
  \setkeys*{mfwrt}{#1}%
  \def\mfw@type{custom}%
  \mfw@rt@checkref
  \mfw@needalt
  \mfw@rt@needposter
  \mfw@needfile{#2}%
  \def\mfw@rt@v{#2}\mfw@rt@checkcomma{primary}%
  \mfw@resolve@id\mfw@sizecanon
  \mfw@snap@fig
  \def\mfw@srcs{primary=#2}%
  \mfw@rt@map\mfw@rt@source\mfw@rt@sources
  \def\mfw@opts{\mfw@dims@opt}%
  \mfw@rt@map\mfw@rt@option\XKV@rm
  \mfw@posterbox{\mfw@runtime}{\mfw@srcs}{\mfw@opts}%
  \mfw@record{\mfw@type}{\mfw@runtime}{\mfw@floatlabel}{\mfw@figno}%
    {\mfw@poster}{\mfw@srcs}{\mfw@opts}%
  \mfw@emit
}

