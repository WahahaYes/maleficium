% maleficium-interactive.sty -- interactive-paper widgets for Maleficium.
% Dedicated to the public domain under CC0 1.0.
% https://creativecommons.org/publicdomain/zero/1.0/
%
% Each macro typesets a poster at the requested size, emits a named PDF
% annotation (/NM (mfw:<id>)) over the poster box, and records the widget in the \jobname.mfw sidecar the compile leaves in
% the outdir. Needs the XeTeX engine (xdvipdfmx specials).
%
% Posters: poster= is the document's own and always wins, so it stands in
% for the widget: leave it out for a model, chart, html or custom-runtime
% widget, whose real render the pdf then shows, and keep it for a video
% (not rendered yet) or a figure you drew by hand. Model, chart and html
% widgets may leave it out: Maleficium then renders one (an html
% widget's only once the user approved its folder, a custom-runtime widget's
% only once the user allowed its runtime, from the runtime's own proposal)
% into the project's .maleficium/posters/ folder and lists it in
% .maleficium/posters/ \jobname.map, which this package reads. A widget uses
% its listed poster only while its recorded runtime, sources and options
% match the list; otherwise, or with no list (another LaTeX setup), it
% shows a placeholder box of the same size. A box without width= is 4:3,
% or a model's size= aspect, so the poster replacing it keeps the layout.
%
% Usage:
%   \maleficiumtheme{house}                    % optional; house is default
%   \maleficiumcontents{off}                   % optional; on is default
%   \maleficiummeasure{wide}                   % optional; default is default
%   \interactivemodel[poster=figures/mesh.png, height=6cm]{models/mesh.glb}
%   \interactivemodel[height=6cm, alt={...}]{models/mesh.glb}  % auto-poster
%   \interactivemodel[poster=figures/mesh.png, size=800x600, background=ffffff,
%     camera={pos=0,1,3 target=0,0,0 up=0,1,0}]{models/mesh.glb}
%   \interactivevideo[poster=figures/clip.png,
%     remote=https://cdn.example.org/clip.mp4, sha256=<hex>]{media/clip.mp4}
%   \interactivetable[pdfrows=10]{data/results.csv}
%   \interactivechart[poster=figures/chart.pdf, scale=2]{charts/ablation.vl.json}
%   \interactive[poster=figures/demo.png, height=8cm]{widgets/demo/}
%   \interactive[height=6cm, alt={...},
%     framedomains=https://www.youtube-nocookie.com]{widgets/talk/}
%   \interactiveruntime[runtime=stl-viewer@1, poster=figures/part.png,
%     alt={...}, sources={texture=img/steel.png}, color=accent]{models/part.stl}
%   \interactiveruntime[runtime=stl-viewer@1,  % no poster=: the runtime proposes one
%     alt={...}]{models/part.stl}
%
% Sidecar line (pipe-separated, one per widget):
%   widget|<id>|<type>|<runtime>|<label>|<figure>|<theme>|<poster>|<sources>|<options>|<alt>
% sources is role=path,... and options is k=v,...; empty fields are empty.
% A custom runtime's widget has type custom, runtime <name>@<major> and its
% main argument under the reserved role primary (the runtime names the role
% when the exporter binds it; this package needs no runtime installed).
% Recorded values never contain |, # or braces; dimensions ride as pt.
%
% Theme lines (written at the end of the document, see "theme" below):
%   theme|light|<token>|<value>   every token of the reader and the widgets
%   theme|dark|<token>|<value>    the tokens that change in dark mode
% The values are CSS (a #rrggbb colour, a font-family list, a length);
% the exporter, the reader and the poster renderer read them from here.
% Every widget declares its text alternative with alt= (used as the HTML
% img alt); there is no caption fallback because the exporter cannot read
% caption text back.
%
% Poster parameters say what the app's rendered poster shows and where a
% live view starts. Model: camera= (braced: 16 numbers of a column-major
% camera-to-world matrix, or pos=x,y,z target=x,y,z up=x,y,z), size=WxH in
% pixels, background= (transparent or a hex colour without #, e.g. ffffff).
% Chart: scale= (poster pixels per CSS pixel). Each is an error on any other
% widget type.
%
% Origins (html only): framedomains= and resourcedomains= name the https
% origins the widget may frame or load from, separated by spaces (commas are
% recorded as spaces), as its folder's widget.json csp.frameDomains and
% csp.resourceDomains do; the two are joined. They go into that widget's
% policy only, and the user approves them with the widget. The camera's commas are recorded as spaces; the app checks
% the numbers. Place the macro after the float's \caption\label for
% label and figure capture; before it, or outside any float, they stay empty
% rather than stale.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{maleficium-interactive}[2026/10/01 Maleficium interactive widgets]

\RequirePackage{keyval}
% Unknown options name their family (`zoom' undefined in families `mfw'):
% xkeyval used to arrive with qrcode, which is gone, so it is asked for
% directly.
\RequirePackage{xkeyval}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{pgfplotstable}
\RequirePackage{etoolbox}
\@ifpackageloaded{hyperref}{}{\RequirePackage[hidelinks]{hyperref}}

% -- look --------------------------------------------------------------------
% The Maleficium palette and two-tone slash, namespaced so template styles
% keep their own definitions.
\definecolor{mfwaccent}{HTML}{5B2A86}
\definecolor{mfwink}{HTML}{1E1B24}
\definecolor{mfwmuted}{HTML}{6B6676}
\colorlet{mfwaccentlt}{mfwaccent!55!white}
\newcommand{\mfwSlash}{%
  \begin{tikzpicture}[baseline=0pt, x=0.085em, y=0.085em]
    \fill[mfwaccentlt] (4.6,-3.5) -- (7.6,-3.5) -- (10.6,4.5) -- (7.6,4.5) -- cycle;
    \fill[mfwaccent]   (0,-3.5)   -- (3.4,-3.5) -- (6.4,4.5)  -- (3.0,4.5) -- cycle;
  \end{tikzpicture}}

% -- state -------------------------------------------------------------------
\newcount\mfw@nextid
\mfw@nextid=1
\newlength{\mfw@dim}
\newlength{\mfw@dimw}
\newif\ifmfw@ok
\def\mfw@theme{house}
\def\mfw@contents{on}
\def\mfw@measure{default}
\def\mfw@floatlabel{}
\newwrite\mfw@sidecar
\newif\ifmfw@sidecar@open
\newsavebox{\mfw@box}

% -- poster map ----------------------------------------------------------------
% Written by the app: \mfw@postermap{<id>}{<runtime>|<sources>|<options>}{<sha256>}
% per widget whose rendered poster exists. The record is kept as a string
% with space runs folded, the same form \mfw@makekey gives the widget's own.
\newcommand{\mfw@postermap}[3]{%
  \mfw@foldspaces{#2}%
  \expandafter\xdef\csname mfw@pm@r@#1\endcsname{\mfw@folded}%
  \expandafter\xdef\csname mfw@pm@k@#1\endcsname{\detokenize{#3}}%
}

% -- keys --------------------------------------------------------------------
\define@key{mfw}{poster}{\def\mfw@poster{#1}}
\define@key{mfw}{height}{\def\mfw@height{#1}}
\define@key{mfw}{width}{\def\mfw@width{#1}}
\define@key{mfw}{id}{\def\mfw@id{#1}}
\define@key{mfw}{runtime}{\def\mfw@runtime{#1}}
\define@key{mfw}{pdfrows}{\def\mfw@pdfrows{#1}}
\define@key{mfw}{remote}{\def\mfw@remote{#1}}
\define@key{mfw}{sha256}{\def\mfw@sha{#1}}
\define@key{mfw}{data}{\def\mfw@data{#1}}
\define@key{mfw}{alt}{\def\mfw@alt{#1}}
\define@key{mfw}{camera}{\def\mfw@p@camera{#1}}
\define@key{mfw}{size}{\def\mfw@p@size{#1}}
\define@key{mfw}{background}{\def\mfw@p@background{#1}}
\define@key{mfw}{scale}{\def\mfw@p@scale{#1}}
\define@key{mfw}{framedomains}{\def\mfw@p@framedomains{#1}}
\define@key{mfw}{resourcedomains}{\def\mfw@p@resourcedomains{#1}}
% \interactiveruntime takes its own key family: the keys it shares with the
% others fill the same macros, and every other key is an author option for the
% runtime (see \mfw@rt@option).
\define@key{mfwrt}{runtime}{\def\mfw@runtime{#1}}
\define@key{mfwrt}{poster}{\def\mfw@poster{#1}}
\define@key{mfwrt}{alt}{\def\mfw@alt{#1}}
\define@key{mfwrt}{height}{\def\mfw@height{#1}}
\define@key{mfwrt}{width}{\def\mfw@width{#1}}
\define@key{mfwrt}{id}{\def\mfw@id{#1}}
\define@key{mfwrt}{sources}{\def\mfw@rt@sources{#1}}
\newcommand{\mfw@resetkeys}{%
  \def\mfw@poster{}\def\mfw@height{6cm}\def\mfw@width{}%
  \def\mfw@id{}\def\mfw@runtime{}\def\mfw@pdfrows{10}%
  \def\mfw@remote{}\def\mfw@sha{}\def\mfw@data{}\def\mfw@alt{}%
  \def\mfw@p@camera{}\def\mfw@p@size{}\def\mfw@p@background{}\def\mfw@p@scale{}%
  \def\mfw@p@framedomains{}\def\mfw@p@resourcedomains{}%
}
% The text alternative is required: it becomes the HTML img alt.
\newcommand{\mfw@needalt}{%
  \ifx\mfw@alt\empty
    \PackageError{maleficium-interactive}%
      {alt= is required: describe the widget in one line}%
      {Pass alt={What a reader gets from this widget}.}%
  \fi
}

% The theme id rides into the sidecar; an unknown id never affects the PDF.
\newcommand{\maleficiumtheme}[1]{%
  \mfw@valid@theme{#1}%
  \ifmfw@ok\else
    \PackageError{maleficium-interactive}%
      {Theme id `#1' must be lowercase letters, digits and dashes}%
      {Use \protect\maleficiumtheme{house} or another id matching [a-z0-9-]+.}%
  \fi
  \gdef\mfw@theme{#1}%
}

% Reader flags: document-level reader settings. They change nothing in the
% PDF (no output, no sidecar line); the HTML conversion carries each call as
% a marker. Closed sets only: anything else fails the compile like a bad id.
\newcommand{\maleficiumcontents}[1]{%
  \def\mfw@flag{#1}%
  \mfw@ifin{\mfw@flag}{on,off}{%
    \gdef\mfw@contents{#1}%
  }{%
    \PackageError{maleficium-interactive}%
      {Contents flag `#1' must be on or off}%
      {Pass \protect\maleficiumcontents{on} or \protect\maleficiumcontents{off}.}%
  }%
}
\newcommand{\maleficiummeasure}[1]{%
  \def\mfw@flag{#1}%
  \mfw@ifin{\mfw@flag}{narrow,default,wide}{%
    \gdef\mfw@measure{#1}%
  }{%
    \PackageError{maleficium-interactive}%
      {Measure flag `#1' must be narrow, default or wide}%
      {Pass \protect\maleficiummeasure{narrow}, \protect\maleficiummeasure{default} or \protect\maleficiummeasure{wide}.}%
  }%
}

% -- strings -------------------------------------------------------------------
% Id validation and slugifying run on the LaTeX3 string layer: hand-rolled
% character loops proved too fragile here, and the kernel routines are tested.
\RequirePackage{expl3}
\ExplSyntaxOn
\str_new:N \g_mfw_slug_str
\str_new:N \l_mfw_slug_str
\bool_new:N \l_mfw_ok_bool
\cs_new_protected:Npn \mfw_slugify: {
  \exp_args:NV \mfw_slugify_inner:n \mfw@floatlabel
}
\cs_new_protected:Npn \mfw_slugify_inner:n #1 {
  \str_set:Nx \l_mfw_slug_str { \str_foldcase:n {#1} }
  \str_replace_all:Nnn \l_mfw_slug_str {:} {-}
  \str_replace_all:Nnn \l_mfw_slug_str {_} {-}
  \regex_replace_all:nnN { [^a-z0-9-] } {} \l_mfw_slug_str
  \str_gset_eq:NN \g_mfw_slug_str \l_mfw_slug_str
  \edef\mfw@slug{\g_mfw_slug_str}
}
\cs_new_protected:Npn \mfw_syncok: {
  \bool_if:NTF \l_mfw_ok_bool { \mfw@oktrue } { \mfw@okfalse }
}
\cs_new_protected:Npn \mfw_valid:n #1 {
  \regex_match:nnTF { \A[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z } {#1}
    { \bool_set_true:N \l_mfw_ok_bool }
    { \bool_set_false:N \l_mfw_ok_bool }
  \mfw_syncok:
}
\cs_new_protected:Npn \mfw_valid_theme:n #1 {
  \regex_match:nnTF { \A[a-z0-9-]+\Z } {#1}
    { \bool_set_true:N \l_mfw_ok_bool }
    { \bool_set_false:N \l_mfw_ok_bool }
  \mfw_syncok:
}
\cs_new_protected:Npn \mfw_valid_digits:n #1 {
  \regex_match:nnTF { \A[0-9]+\Z } {#1}
    { \bool_set_true:N \l_mfw_ok_bool }
    { \bool_set_false:N \l_mfw_ok_bool }
  \mfw_syncok:
}
\cs_new_protected:Npn \mfw_nobar:n #1 {
  \str_if_in:nnTF {#1} {|}
    { \bool_set_false:N \l_mfw_ok_bool }
    { \bool_set_true:N \l_mfw_ok_bool }
  \mfw_syncok:
}
\str_new:N \l_mfw_cam_str
\cs_new_protected:Npn \mfw_match:Nn #1 #2 {
  \exp_args:NnV \regex_match:nnTF {#2} #1
    { \bool_set_true:N \l_mfw_ok_bool }
    { \bool_set_false:N \l_mfw_ok_bool }
  \mfw_syncok:
}
% Poster parameter shapes; the app parses the values themselves.
\cs_new_protected:Npn \mfw@check@camera {
  \str_set:Nx \l_mfw_cam_str { \mfw@p@camera }
  \str_replace_all:Nnn \l_mfw_cam_str { , } { ~ }
  \tl_set:Nx \mfw@p@camera { \l_mfw_cam_str }
  \mfw_match:Nn \mfw@p@camera { \A(?:[0-9eE.+\-\s]|pos=|target=|up=)+\Z }
}
\cs_new_protected:Npn \mfw@check@size
  { \mfw_match:Nn \mfw@p@size { \A[0-9]+x[0-9]+\Z } }
\cs_new_protected:Npn \mfw@check@background
  { \mfw_match:Nn \mfw@p@background { \A(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|transparent)\Z } }
\cs_new_protected:Npn \mfw@check@scale
  { \mfw_match:Nn \mfw@p@scale { \A[0-9]*\.?[0-9]+\Z } }
% Origins: commas become spaces (the sidecar splits options on commas);
% the shape is checked here, every origin itself by the app.
\cs_new_protected:Npn \mfw_origins:N #1 {
  \str_set:Nx \l_mfw_cam_str { #1 }
  \str_replace_all:Nnn \l_mfw_cam_str { , } { ~ }
  \tl_set:Nx #1 { \l_mfw_cam_str }
  \mfw_match:Nn #1 { \A\s*https://[a-z0-9.:\-]+(?:\s+https://[a-z0-9.:\-]+)*\s*\Z }
}
\cs_new_protected:Npn \mfw@check@framedomains { \mfw_origins:N \mfw@p@framedomains }
\cs_new_protected:Npn \mfw@check@resourcedomains { \mfw_origins:N \mfw@p@resourcedomains }
% Custom runtimes: shapes of the ref, a source role and an option key (the
% app checks the same ones again). The reserved names are the built-in kinds
% and the package's own prefixes; the reserved keys are every key the other
% macros take plus the two the sidecar uses (sources, primary). Each takes
% the macro holding the text and sets \ifmfw@ok.
\cs_new_protected:Npn \mfw@rt@isref #1
  { \mfw_match:Nn #1 { \A[a-z][a-z0-9-]{1,39}@[1-9][0-9]{0,3}\Z } }
\cs_new_protected:Npn \mfw@rt@isreservedname #1
  { \mfw_match:Nn #1 { \A(?:model|video|table|chart|html|custom)\Z|\Am-|\Amaleficium } }
% The name of a ref (up to the @) into \mfw@rt@n. Not a delimited macro: the
% @ in the document is not a letter, as it is here.
\cs_new_protected:Npn \mfw@rt@setname #1
  {
    \tl_set_eq:NN \mfw@rt@n #1
    \regex_replace_once:nnN { @.*\Z } { } \mfw@rt@n
  }
\cs_new_protected:Npn \mfw@rt@iskey #1
  { \mfw_match:Nn #1 { \A[a-z][a-z0-9]{0,23}\Z } }
\cs_new_protected:Npn \mfw@rt@isreservedkey #1
  { \mfw_match:Nn #1
    { \A(?:runtime|poster|height|width|id|alt|sources|primary|inline|remote|sha256|pdfrows|data|camera|size|background|scale|framedomains|resourcedomains)\Z } }
% A role is a plain word and never the reserved primary.
\cs_new_protected:Npn \mfw@rt@isrole #1
  {
    \mfw_match:Nn #1 { \A[a-z][a-z0-9]{0,15}\Z }
    \ifmfw@ok
      \mfw_match:Nn #1 { \Aprimary\Z }
      \ifmfw@ok \mfw@okfalse \else \mfw@oktrue \fi
    \fi
  }
% Recorded options and sources are split on commas by the app, so no value
% may hold one (\mfw@ok is true when it does not).
\cs_new_protected:Npn \mfw@rt@nocomma #1
  {
    \tl_if_in:NnTF #1 { , }
      { \bool_set_false:N \l_mfw_ok_bool }
      { \bool_set_true:N \l_mfw_ok_bool }
    \mfw_syncok:
  }
% Trim the spaces round a key or a value held in a macro.
\cs_new_protected:Npn \mfw@rt@trim #1 { \tl_trim_spaces:N #1 }
% Append ,<key>=<value> (macros \mfw@rt@k and \mfw@rt@v, kept verbatim) to #1.
\cs_new_protected:Npn \mfw@rt@add #1
  { \tl_put_right:Nx #1 { , \exp_not:V \mfw@rt@k = \exp_not:V \mfw@rt@v } }
% Run \mfw@rt@... item handler #1 on every entry of the comma list in macro #2
% (spaces round an entry are trimmed, empty entries skipped).
\cs_new_protected:Npn \mfw@rt@map #1 #2
  { \exp_args:NV \clist_map_inline:nn #2 { #1 {##1} } }
% Record strings as the poster map holds them: detokenized, every run of
% white space one space (TeX folds them when it reads the map back).
\str_new:N \l_mfw_fold_str
\cs_new_protected:Npn \mfw@foldspaces #1 {
  \str_set:Nn \l_mfw_fold_str {#1}
  \regex_replace_all:nnN { \s+ } { \  } \l_mfw_fold_str
  \tl_set:Nx \mfw@folded { \l_mfw_fold_str }
}
\cs_new_protected:Npn \mfw@foldspaces@x #1 {
  \str_set:Nx \l_mfw_fold_str {#1}
  \regex_replace_all:nnN { \s+ } { \  } \l_mfw_fold_str
  \tl_set:Nx \mfw@folded { \l_mfw_fold_str }
}
% A font family's key for the theme's font table: lowercase letters and
% digits of the NFSS family (lmr) or the fontspec one (LibertinusSerif(0),
% LibertinusSerif-Regular.otf(0)), without the instance number, the file
% extension and a -Regular suffix.
\str_new:N \l_mfw_font_str
\cs_new_protected:Npn \mfw@fontkey #1 {
  \str_set:Nx \l_mfw_font_str {#1}
  \str_set:Nx \l_mfw_font_str { \exp_args:NV \str_foldcase:n \l_mfw_font_str }
  \regex_replace_once:nnN { \(\d*\)\Z } {} \l_mfw_font_str
  \regex_replace_once:nnN { \.(otf|ttf)\Z } {} \l_mfw_font_str
  \regex_replace_once:nnN { -regular\Z } {} \l_mfw_font_str
  \regex_replace_all:nnN { [^a-z0-9] } {} \l_mfw_font_str
  \tl_set:Nx \mfw@key { \l_mfw_font_str }
}
% Plain-name entry points for the LaTeX2e body below.
\cs_new_protected:Npn \mfw@slugify { \mfw_slugify: }
\cs_new_protected:Npn \mfw@valid@id { \exp_args:NV \mfw_valid:n \mfw@id }
\cs_new_protected:Npn \mfw@valid@slug { \exp_args:NV \mfw_valid:n \g_mfw_slug_str }
\cs_new_protected:Npn \mfw@valid@theme #1 { \mfw_valid_theme:n {#1} }
% Reader styling: a stylesheet is a plain .css path.
\cs_new_protected:Npn \mfw@valid@css #1 {
  \regex_match:nnTF { \A[A-Za-z0-9._/-]+\.[cC][sS][sS]\Z } {#1}
    { \bool_set_true:N \l_mfw_ok_bool }
    { \bool_set_false:N \l_mfw_ok_bool }
  \mfw_syncok:
}
\cs_new_protected:Npn \mfw@valid@digits { \exp_args:NV \mfw_valid_digits:n \mfw@pdfrows }
\cs_new_protected:Npn \mfw@check@nobar #1 { \exp_args:NV \mfw_nobar:n #1 }
\ExplSyntaxOff

% The float's own label, and only that: entering a float clears it, labels
% record only while inside one, and leaving clears it again. Entering a
% subfigure clears it too, so panels never read each other's labels. A widget outside
% a float, or placed before its float's \caption\label, records empty label
% and figure instead of a neighbour's.
\newif\ifmfw@infloat
\AtBeginDocument{%
  \let\mfw@orig@label\label
  \renewcommand{\label}[1]{\mfw@orig@label{#1}%
    \ifmfw@infloat\gdef\mfw@floatlabel{#1}\fi}%
}
\newcommand{\mfw@enterfloat}{\gdef\mfw@floatlabel{}\global\mfw@infloattrue}
\newcommand{\mfw@leavefloat}{\gdef\mfw@floatlabel{}\global\mfw@infloatfalse}
\AtBeginEnvironment{figure}{\mfw@enterfloat}
\AtBeginEnvironment{table}{\mfw@enterfloat}
\AtBeginEnvironment{figure*}{\mfw@enterfloat}
\AtBeginEnvironment{table*}{\mfw@enterfloat}
\AtEndEnvironment{figure}{\mfw@leavefloat}
\AtEndEnvironment{table}{\mfw@leavefloat}
\AtEndEnvironment{figure*}{\mfw@leavefloat}
\AtEndEnvironment{table*}{\mfw@leavefloat}
% A new panel clears the last one's label, but the float is still open:
% unlike entering a float this never touches \ifmfw@infloat, so the outer
% \caption\label still records. Without it a widget before its panel's
% \caption\label reads its neighbour's label and figure number (whose value
% may also hold caption internals no expansion survives), instead of empty.
\newcommand{\mfw@clearsub}{\gdef\mfw@floatlabel{}}
\AtBeginEnvironment{subfigure}{\mfw@clearsub}
\AtEndEnvironment{subfigure}{\mfw@clearsub}
% The figure number rides along only when a label anchors it; otherwise the
% counter still holds whatever came before and is left out.
\newcommand{\mfw@snap@fig}{%
  \ifx\mfw@floatlabel\empty\def\mfw@figno{}%
  \else\protected@edef\mfw@figno{\@currentlabel}\fi
}

% Resolve the widget id: pinned, slugified, or w-<n>. Duplicates fail naming
% both lines; an unusable slug falls back to w-<n> with a warning.
\newcommand{\mfw@resolve@id}{%
  \ifx\mfw@id\empty
    \ifx\mfw@floatlabel\empty
      \mfw@take@counter
    \else
      \mfw@slugify
      \ifx\mfw@slug\empty\mfw@take@counter\else
        \mfw@valid@slug
        \ifmfw@ok\let\mfw@id\mfw@slug\else\mfw@take@counter\fi
      \fi
    \fi
  \else
    \mfw@valid@id
    \ifmfw@ok\else
      \PackageError{maleficium-interactive}%
        {Widget id `\mfw@id' must match [a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?}%
        {Pass id=fig-teaser or leave it out for an automatic w-<n>.}%
    \fi
  \fi
  \expandafter\ifx\csname mfw@seen@\mfw@id\endcsname\relax
    \expandafter\xdef\csname mfw@seen@\mfw@id\endcsname{\the\inputlineno}%
  \else
    \PackageError{maleficium-interactive}%
      {Duplicate widget id `\mfw@id' (first used on line
        \csname mfw@seen@\mfw@id\endcsname)}%
      {Pass a unique id=... to one of the two widgets.}%
  \fi
}
\newcommand{\mfw@take@counter}{%
  \edef\mfw@id{w-\the\mfw@nextid}%
  \global\advance\mfw@nextid by 1
  \ifx\mfw@floatlabel\empty\else
    \PackageWarning{maleficium-interactive}%
      {Label `\mfw@floatlabel' does not slugify; widget is \mfw@id}%
  \fi
}

% -- sidecar -----------------------------------------------------------------
% Values are fully expanded before detokenizing, so option macros arrive as
% text. Raw characters (% # ~) never reach here with surprising catcodes:
% keyval already tokenized them at the call site.
\newcommand{\mfw@safe}[2]{%
  \edef\mfw@tmp{#1}%
  \expandafter\edef\csname#2\endcsname{\expandafter\detokenize\expandafter{\mfw@tmp}}%
  \mfw@nobar{#2}%
}
% An empty value holds no pipe; checking it would V-pass nothing and grab
% a stray token instead.
\newcommand{\mfw@nobar}[1]{%
  \expandafter\ifx\csname#1\endcsname\empty\mfw@oktrue\else
    \expandafter\mfw@check@nobar\csname#1\endcsname
    \ifmfw@ok\else\PackageError{maleficium-interactive}%
      {character `|' is not allowed in #1}{Remove it from the value.}\fi
  \fi
}
\newcommand{\mfw@open@sidecar}{%
  \ifmfw@sidecar@open\else
    \immediate\openout\mfw@sidecar=\jobname.mfw
    \immediate\write\mfw@sidecar{mfw 1}%
    \global\mfw@sidecar@opentrue
  \fi
}
% #1 type, #2 runtime, #3 label, #4 figure, #5 poster, #6 sources, #7 options.
% Alt rides separately: it is recorded verbatim for the HTML img alt.
\newcommand{\mfw@record}[7]{%
  \mfw@open@sidecar
  \mfw@safe{\mfw@id}{mfw@s@id}%
  \mfw@safe{#1}{mfw@s@type}%
  \mfw@safe{#2}{mfw@s@rt}%
  \mfw@safe{#3}{mfw@s@label}%
  \mfw@safe{#4}{mfw@s@fig}%
  \mfw@safe{\mfw@theme}{mfw@s@theme}%
  \mfw@safe{#5}{mfw@s@poster}%
  \mfw@safe{#6}{mfw@s@src}%
  \mfw@safe{#7}{mfw@s@opt}%
  \mfw@safe{\mfw@alt}{mfw@s@alt}%
  \immediate\write\mfw@sidecar{widget|\mfw@s@id|\mfw@s@type|\mfw@s@rt|%
    \mfw@s@label|\mfw@s@fig|\mfw@s@theme|\mfw@s@poster|\mfw@s@src|\mfw@s@opt|\mfw@s@alt}%
}

