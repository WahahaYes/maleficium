% maleficium.sty -- the shared look of the Maleficium resume and CV templates.
% Dedicated to the public domain under CC0 1.0.
% https://creativecommons.org/publicdomain/zero/1.0/
%
% The resume and the CV load this same file, so they read as one family. The
% main file holds only content and calls the commands below; change the look
% here and both documents follow. Needs XeTeX or LuaTeX (fontspec).
%
% Design: left-aligned name, one violet accent on warm ink, letterspaced
% small-cap headings that hang a short thick stub over a hairline, dates set
% flush right in muted type.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{maleficium}[2026/09/30 Maleficium resume and CV style]

\RequirePackage{xcolor}
\RequirePackage{fontspec}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{microtype}
\RequirePackage{needspace}
\RequirePackage{etoolbox}
\RequirePackage{xurl}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage[hidelinks]{hyperref}
\urlstyle{same}

% -- type -------------------------------------------------------------------
% Libertinus (SIL OFL), a complete family in the bundle. Three roles, all loaded by file name from the TeX bundle so the output
% matches on every machine:
%   body     running text, entries, dates
%   display  the name at the top of the page
%   caps     tracked capitals: section headings and the tagline
% microtype's \textls does not run under XeTeX, so letterspacing is done with
% fontspec's LetterSpace on the caps face.
%%FONTS-BEGIN
\setmainfont{LibertinusSerif-Regular.otf}[
  BoldFont = LibertinusSerif-Bold.otf,
  ItalicFont = LibertinusSerif-Italic.otf,
  BoldItalicFont = LibertinusSerif-BoldItalic.otf]
\newfontfamily\mlDisplayFont{LibertinusSerif-Semibold.otf}
\newfontfamily\mlTracked{LibertinusSans-Regular.otf}[
  BoldFont = LibertinusSans-Bold.otf, LetterSpace = 10.0]
\newfontfamily\mlChipFont{LibertinusSans-Regular.otf}[LetterSpace = 2.0]
%%FONTS-END

% -- knobs -------------------------------------------------------------------
\newcommand{\mlAccent}{5B2A86}      % hex, no '#'
\newcommand{\mlInk}{1E1B24}
\newcommand{\mlMuted}{6B6676}
\newlength{\mlGap}\setlength{\mlGap}{4pt}   % the density unit
\newcommand{\mlSetAccent}[1]{\renewcommand{\mlAccent}{#1}\mlDefineColors}
\newcommand{\mlSetDensity}[1]{\setlength{\mlGap}{#1}}
\newcommand{\mlDefineColors}{%
  \definecolor{mlaccent}{HTML}{\mlAccent}%
  \definecolor{mlink}{HTML}{\mlInk}%
  \definecolor{mlmuted}{HTML}{\mlMuted}%
  \definecolor{mlhair}{HTML}{D9D5E0}%
  \colorlet{mlaccentlt}{mlaccent!55!white}%
}
\mlDefineColors
\AtBeginDocument{\color{mlink}}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}

\setlength{\emergencystretch}{3em}
\tolerance=1200\hbadness=3000
\raggedbottom

% -- headings ----------------------------------------------------------------
% A two-tone slash (dark over light, like the Maleficium mark's cut) stands on
% a hairline, then the title in tracked caps. titlesec keeps a heading
% attached to the line that follows it.
\newcommand{\mlSlash}{%
  \begin{tikzpicture}[baseline=0pt, x=1pt, y=1pt]
    \fill[mlaccentlt] (4.6,-3) -- (7.6,-3) -- (10.6,4) -- (7.6,4) -- cycle;
    \fill[mlaccent]   (0,-3)   -- (3.4,-3) -- (6.4,4)  -- (3.0,4) -- cycle;
  \end{tikzpicture}}
\newcommand{\mlHeadText}[1]{{\mlTracked\small\MakeUppercase{#1}}}
\newcommand{\mlHeadRule}{%
  \nopagebreak[4]\vspace{0.9\mlGap}{\color{mlhair}\titlerule[0.4pt]}\nointerlineskip
  \noindent\raisebox{\dimexpr\ht\strutbox-0.4pt\relax}[0pt][0pt]{\mlSlash}\par
  \vspace{-\dimexpr\ht\strutbox+\dp\strutbox\relax}%
  \nopagebreak[4]}
\titleformat{\section}[block]
  {\normalfont\bfseries\color{mlaccent}}{}{0pt}
  {\mlHeadText}
  [\mlHeadRule]
\titlespacing*{\section}{0pt}{2\mlGap}{2\mlGap}
% \mlSection{Experience}
\newcommand{\mlSection}[1]{\Needspace*{4\baselineskip}\section{#1}}

% -- the header --------------------------------------------------------------
% \mlName{First Last}  \mlTagline{Role you want}  \mlContact{a \mlSep b}
\newcommand{\mlName}[1]{%
  {\mlDisplayFont\fontsize{26}{28}\selectfont\color{mlink}#1}\par}
\newcommand{\mlTagline}[1]{%
  \vspace{0.4\mlGap}{\color{mlaccent}\mlTracked\footnotesize\MakeUppercase{#1}}\par}
% The separator is a discretionary: where a line breaks it vanishes, so no
% line starts or ends on a bare bullet. The contact block is set ragged so a
% long item can never stretch the spaces or run past the margin.
\newcommand{\mlSep}{\discretionary{}{}{\kern0.55em\raisebox{0.1ex}{\textcolor{mlaccent}{\textbullet}}\kern0.55em}}
\newcommand{\mlContact}[1]{%
  \vspace{0.6\mlGap}{\small\color{mlmuted}\raggedright\sloppy #1\par}\vspace{0.4\mlGap}}
% \mlLink{url}{text}
\newcommand{\mlLink}[2]{\href{#1}{#2}}
% \mlUrlLink{url}{text}: like \mlLink, but the text may break across lines
% (a long DOI otherwise runs off the margin). Text must be a plain URL form.
\newcommand{\mlUrlLink}[2]{\href{#1}{\nolinkurl{#2}}}

% \mlSummary{text} -- a lede paragraph, set apart from the body.
\newcommand{\mlSummary}[1]{\vspace{0.8\mlGap}{\small\color{mlmuted}#1}\par}

% -- body vocabulary ---------------------------------------------------------
% \mlEntry{Title}{Dates}{Organisation}{Place}  -- a titled, dated entry.
\newcommand{\mlEntry}[4]{%
  \noindent\textbf{#1}\hfill{\small\color{mlmuted}#2}\par\nopagebreak
  \ifstrempty{#3#4}{}{\vspace{0.1\mlGap}%
    \noindent{\small\color{mlaccent}#3}\hfill{\small\itshape\color{mlmuted}#4}\par}%
  \vspace{0.3\mlGap}}

% Bullets: a small accent square.
\newlist{mlbullets}{itemize}{1}
\setlist[mlbullets,1]{leftmargin=1.1em, itemsep=0.25\mlGap, topsep=0pt,
  parsep=0pt, partopsep=0pt, after=\vspace{0.9\mlGap},
  label=\raisebox{0.2ex}{\textcolor{mlaccent}{\rule{0.38em}{0.38em}}}}

% Numbered citations: [1] ...
\newlist{mlcites}{enumerate}{1}
\setlist[mlcites,1]{leftmargin=2em, labelsep=0.4em, itemsep=0.35\mlGap,
  topsep=0pt, parsep=0pt, after=\vspace{0.9\mlGap},
  label=\textcolor{mlaccent}{\small[\arabic*]}}

% \mlDated{Year}{Text} -- one dated line: awards, service, funding, talks.
\newlength{\mlDateW}\setlength{\mlDateW}{4.4em}
\newlength{\mlLabelW}\setlength{\mlLabelW}{6.4em}
% \mlDateWidth{2020--2025} / \mlLabelWidth{Infrastructure}: size the left
% column of the next \mlDated or \mlLabeled lines to fit the given widest text.
\newcommand{\mlDateWidth}[1]{%
  \settowidth{\mlDateW}{\small\bfseries #1}\addtolength{\mlDateW}{1em}}
\newcommand{\mlLabelWidth}[1]{%
  \settowidth{\mlLabelW}{\small\bfseries #1}\addtolength{\mlLabelW}{1em}}
\newcommand{\mlDated}[2]{%
  \noindent\hangindent=\mlDateW\hangafter=1
  \makebox[\mlDateW][l]{\small\color{mlaccent}\bfseries #1}#2\par
  \vspace{0.25\mlGap}}

% \mlLabeled{Label}{Items} -- skills, languages, interests.
\newcommand{\mlLabeled}[2]{%
  \noindent\hangindent=\mlLabelW\hangafter=1
  \makebox[\mlLabelW][l]{\small\color{mlaccent}\bfseries #1}#2\par
  \vspace{0.25\mlGap}}


% \mlTagGroup{Label}{\mlTag{One}\mlTag{Two}} -- skills as rounded pills, wrapping
% beside a label. Each pill is a tinted card with a hairline accent border.
\usetikzlibrary{calc,backgrounds}
% A chip leans like the heading slash: a slanted card in a pale accent tint,
% with a dark slanted tab on its left edge. The text node is a plain
% rectangle; the slanted shapes are drawn behind it.
\tikzset{mlchip/.style={inner xsep=10pt, inner ysep=1.6pt, text=mlink}}
\newcommand{\mlTag}[1]{%
  \tikz[baseline=(mlp.base)]{%
    \pgfmathsetmacro{\mlChipSz}{\f@size+0}%
    \node[mlchip](mlp){\mlChipFont
      \fontsize{\mlChipSz}{0}\selectfont
      \rule[-0.3em]{0pt}{1.02em}#1};
    \begin{scope}[on background layer]
      \fill[mlaccent!13] (mlp.south west) -- ($(mlp.south east)+(-3pt,0)$)
        -- (mlp.north east) -- ($(mlp.north west)+(3pt,0)$) -- cycle;
      \fill[mlaccent] (mlp.south west) -- ($(mlp.south west)+(2.4pt,0)$)
        -- ($(mlp.north west)+(5.4pt,0)$) -- ($(mlp.north west)+(3pt,0)$) -- cycle;
      \fill[mlaccentlt] ($(mlp.south west)+(3.6pt,0)$) -- ($(mlp.south west)+(5.6pt,0)$)
        -- ($(mlp.north west)+(8.6pt,0)$) -- ($(mlp.north west)+(6.6pt,0)$) -- cycle;
    \end{scope}}%
  \hskip 0.5em plus 0.25em\relax}
\newcommand{\mlTagGroup}[2]{%
  \begingroup\noindent\hangindent=\mlLabelW\hangafter=1
  \makebox[\mlLabelW][l]{\small\color{mlaccent}\bfseries #1}%
  {\pgfmathsetmacro{\mlLead}{\f@size*1.8}\fontsize{\f@size}{\mlLead}\selectfont\raggedright #2\par}\endgroup
  \vspace{0.2\mlGap}}

% \mlMe{Name} -- your own name inside an author list.
\newcommand{\mlMe}[1]{\textbf{#1}}
% \mlVenue{Venue} and \mlBadge{text} for citation lines.
\newcommand{\mlVenue}[1]{\textit{#1}}
\newcommand{\mlBadge}[1]{{\small\color{mlmuted}(#1)}}
% \mlNote{text} -- a muted aside under a heading.
\newcommand{\mlNote}[1]{{\small\itshape\color{mlmuted}#1}\par\vspace{0.4\mlGap}}

% No page numbers; the "Made with Maleficium" mark lives in maleficium-footer.sty.
\pagestyle{empty}

\endinput
