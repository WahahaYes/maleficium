% maleficium-footer.sty -- the "Made with Maleficium" mark in the bottom-right
% corner of every page. Dedicated to the public domain under CC0 1.0.
% https://creativecommons.org/publicdomain/zero/1.0/
%
% To remove it, delete the \usepackage{maleficium-footer} line from main.tex.
% The mark keeps its own colours and links to the project page. It is drawn on
% top of the page, so it works with any page style or class. Needs
% maleficium-mark.pdf beside it, and XeTeX or LuaTeX.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{maleficium-footer}[2026/09/30 Maleficium footer mark]

\RequirePackage{eso-pic}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\@ifpackageloaded{hyperref}{}{\RequirePackage[hidelinks]{hyperref}}

\newcommand{\mlHome}{https://github.com/WahahaYes/maleficium}
\newcommand{\mlFooterMark}{%
  \href{\mlHome}{\raisebox{-0.25em}{\includegraphics[height=1.15em]{maleficium-mark.pdf}}%
    \hspace{0.4em}{\sffamily\scriptsize\color[HTML]{6B6676}Made with Maleficium}}}

% Right-aligned to the right edge of the text block, by page parity.
\newlength{\mlFooterRight}
\AddToShipoutPictureFG{%
  \AtPageLowerLeft{%
    \@ifundefined{beamer@rightmargin}{%
      \setlength{\mlFooterRight}{\dimexpr1in+\ifodd\value{page}\oddsidemargin\else\evensidemargin\fi+\textwidth\relax}}{%
      \setlength{\mlFooterRight}{\dimexpr\paperwidth-\beamer@rightmargin\relax}}%
    \put(\LenToUnit{\mlFooterRight},\LenToUnit{0.32in}){\makebox(0,0)[br]{\mlFooterMark}}}}

\endinput
