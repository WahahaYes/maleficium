{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maleficium",
  "version": "0.2.0",
  "identifier": "io.github.wahahayes.maleficium",
  "build": {
    "beforeDevCommand": "npm run dev:serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Maleficium",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: blob: data:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: blob: data:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1421",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "publisher": "Ethan Wilson",
    "homepage": "https://github.com/wahahayes/maleficium",
    "category": "Productivity",
    "shortDescription": "Desktop-native LaTeX editor",
    "longDescription": "Maleficium is a desktop-native LaTeX editor.\nIt bundles the Tectonic engine for fully offline compiles after the first bundle download.",
    "copyright": "Copyright 2026 Ethan Wilson",
    "license": "Apache-2.0",
    "externalBin": ["binaries/maleficium-tectonic", "binaries/maleficium-synctex"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libgraphite2-3"],
        "section": "editors"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
