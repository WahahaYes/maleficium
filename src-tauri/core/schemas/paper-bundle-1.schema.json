{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maleficium-paper-bundle/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "generator",
    "paper",
    "pdf",
    "theme",
    "widgets",
    "assets"
  ],
  "properties": {
    "format": { "const": "maleficium-paper-bundle" },
    "formatVersion": { "const": 1 },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "const": "maleficium" }, "version": { "type": "string" } }
    },
    "profile": { "enum": ["folder", "single-file", "hosted"] },
    "sizeCapBytes": { "type": "integer", "minimum": 0 },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authors"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "affiliations": { "type": "array", "items": { "type": "string" } },
              "orcid": { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" }
            }
          }
        },
        "abstract": { "type": "string" },
        "versionLabel": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "doi": { "type": "string" },
        "license": {
          "type": "string",
          "description": "SPDX id of the paper's license, e.g. CC-BY-4.0"
        },
        "reader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contents", "measure"],
          "properties": {
            "contents": {
              "type": "boolean",
              "default": true,
              "description": "whether the article shows its contents list; false omits the nav"
            },
            "measure": {
              "enum": ["narrow", "default", "wide"],
              "default": "default",
              "description": "the article column width: narrow 56ch, default 68ch (the theme's --m-measure), wide 80ch"
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "url"],
            "properties": {
              "kind": { "enum": ["project", "code", "data", "preprint", "publisher", "other"] },
              "url": { "type": "string", "format": "uri", "pattern": "^https://" }
            }
          }
        }
      }
    },
    "pdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "pages"],
      "properties": {
        "path": {
          "type": ["string", "null"],
          "description": "paper.pdf; null when inlined (single-file)"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "pages": { "type": "integer", "minimum": 1 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "contractVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "widgets": { "type": "array", "items": { "$ref": "#/$defs/widget" } },
    "runtimes": {
      "type": "object",
      "description": "the custom runtimes live widgets run, by ref; omitted when none",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,39}@[1-9][0-9]{0,3}$" },
      "additionalProperties": { "$ref": "#/$defs/runtime" }
    },
    "assets": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]*$" },
      "additionalProperties": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "license": {
      "enum": [
        "MIT",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "Apache-2.0",
        "ISC",
        "Zlib",
        "0BSD",
        "CC0-1.0",
        "Unlicense"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest", "license", "capabilities", "vendored"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "digest": { "$ref": "#/$defs/sha256" },
        "license": { "$ref": "#/$defs/license" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["webgl"],
          "properties": { "webgl": { "type": "boolean" }, "wasm": { "type": "boolean" } }
        },
        "vendored": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "license"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "license": { "$ref": "#/$defs/license" }
            }
          }
        }
      }
    },
    "assetRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "key into assets"
    },
    "origin": {
      "type": "string",
      "description": "https, a lowercase DNS name or IPv4 address (labels of 1-63, host at most 253), an optional port 1-65535 without leading zeros; no wildcard, path or credentials",
      "pattern": "^https://(?=[a-z0-9.-]{1,253}(?::|$))[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
    },
    "rect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" },
      "description": "[x0, y0, x1, y1] in PDF user units, origin bottom-left, x0<x1, y0<y1"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sha256", "bytes", "mime"],
      "properties": {
        "mode": { "enum": ["bundled", "inline", "remote"] },
        "path": { "type": ["string", "null"], "pattern": "^assets/[0-9a-f]{64}\\.[a-z0-9]+$" },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mime": { "type": "string" },
        "source": {
          "type": "string",
          "description": "project-relative path; never absolute, never ../"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "bundled" } } },
          "then": { "required": ["path"], "properties": { "path": { "type": "string" } } }
        },
        {
          "if": { "properties": { "mode": { "const": "inline" } } },
          "then": { "properties": { "path": { "const": null } } }
        },
        {
          "if": { "properties": { "mode": { "const": "remote" } } },
          "then": { "required": ["url"] }
        }
      ]
    },
    "csp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connectDomains": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/origin" }
        },
        "resourceDomains": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/origin" }
        },
        "frameDomains": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/origin" } }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "page", "rect", "poster", "alt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$" },
        "type": { "enum": ["model", "video", "table", "chart", "html", "custom"] },
        "runtime": {
          "type": "string",
          "description": "built-in runtime and its major version, or a custom runtime's ref; absent for html"
        },
        "fallback": {
          "enum": ["runtime-missing", "runtime-invalid", "unapproved", "denied"],
          "description": "why a custom widget exports as its poster only"
        },
        "entry": {
          "type": "string",
          "description": "widgets/<id>/index.html; null in single-file"
        },
        "page": { "type": "integer", "minimum": 1 },
        "rect": { "$ref": "#/$defs/rect" },
        "label": {
          "type": "string",
          "description": "LaTeX \\label of the enclosing float, if any"
        },
        "figure": {
          "type": "string",
          "description": "rendered float number as in the PDF, e.g. \"3\" or \"3b\""
        },
        "poster": { "$ref": "#/$defs/assetRef" },
        "alt": {
          "type": "string",
          "minLength": 1,
          "description": "text alternative; defaults to the caption"
        },
        "sources": {
          "type": "object",
          "description": "runtime inputs by role, e.g. {\"model\": \"mesh\"}; values are asset refs",
          "additionalProperties": { "$ref": "#/$defs/assetRef" }
        },
        "options": {
          "type": "object",
          "description": "runtime options passed through from the .sty, validated by the runtime"
        },
        "csp": { "$ref": "#/$defs/csp" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "html" } } },
          "then": { "not": { "required": ["runtime"] } },
          "else": { "required": ["runtime", "sources"] }
        },
        {
          "if": { "properties": { "type": { "const": "custom" } } },
          "then": {
            "properties": { "runtime": { "pattern": "^[a-z][a-z0-9-]{1,39}@[1-9][0-9]{0,3}$" } },
            "not": { "required": ["csp"] }
          },
          "else": {
            "properties": { "runtime": { "pattern": "^(model|video|table|chart)@\\d+$" } },
            "not": { "required": ["fallback"] }
          }
        },
        {
          "if": { "required": ["fallback"] },
          "then": {
            "properties": { "sources": { "maxProperties": 0 } },
            "allOf": [{ "not": { "required": ["entry"] } }, { "not": { "required": ["options"] } }]
          }
        }
      ]
    }
  }
}
