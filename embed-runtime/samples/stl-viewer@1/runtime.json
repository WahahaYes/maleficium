  },
  "options": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "autorotate": {
        "type": "boolean",
        "default": false,
        "description": "Slowly turn the model."
      }
    }
  },
  "capabilities": { "webgl": false },
  "vendored": []
}
