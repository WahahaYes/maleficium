{
  "contract": 1,
  "name": "stl-viewer",
  "version": "1.0.0",
  "title": "STL viewer",
  "description": "Shows an ASCII STL model as a canvas wireframe. No libraries.",
  "authors": ["Maleficium contributors"],
  "license": "MIT-0",
  "sources": {
    "model": {
      "primary": true,
      "required": true,
      "extensions": ["stl"],
      "description": "ASCII STL facets."
