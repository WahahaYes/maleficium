{
  "contract": 1,
  "name": "heatmap",
  "version": "1.0.0",
  "title": "Heatmap",
  "description": "Draws a CSV grid of numbers as a canvas heatmap.",
  "authors": ["Maleficium contributors"],
  "license": "MIT-0",
  "sources": {
    "data": {
      "primary": true,
      "required": true,
      "extensions": ["csv"],
      "description": "A grid of numbers, one row per line."
    }
  },
  "options": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "scheme": {
        "type": "string",
        "enum": ["seq", "div"],
        "default": "seq",
        "description": "Colour ramp: one-sided or diverging."
      }
    }
  },
  "capabilities": { "webgl": false },
  "vendored": []
}
