# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# The engine sidecar: built by scripts/build-engine.sh, never tracked
src-tauri/binaries/

# The latexml format dumps: generated by scripts/build-engine.sh, bundled as
# app resources, never tracked (the directory itself is, so a fresh checkout
# still builds the app)
src-tauri/resources/dumps/*
!src-tauri/resources/dumps/.gitkeep
__pycache__/

# scripts/package.sh output
/out

# scripts/playground.sh output
/playground
